{
  "expo": {
    "name": "Sallitna",
    "slug": "sallitna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sallitna",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mostafa.sallitna"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F4EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mostafa.sallitna"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "سلّتنا محتاجة صورك عشان تضيف صورة للحاجة اللي هتتشرى. Sallitna uses your photos to show what to buy.",
          "cameraPermission": "سلّتنا محتاجة الكاميرا عشان تصوّر الحاجة اللي هتتشرى. Sallitna uses the camera to photograph what to buy.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8731A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F6F4EF"
  }
}
