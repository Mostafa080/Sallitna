{
  "expo": {
    "name": "Sallitna",
    "slug": "sallitna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sallitna",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mostafa.sallitna",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E7A42",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mostafa.sallitna"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "سلّتنا محتاجة صورك عشان تضيف صورة للحاجة اللي هتتشرى. Sallitna uses your photos to show what to buy.",
          "cameraPermission": "سلّتنا محتاجة الكاميرا عشان تصوّر الحاجة اللي هتتشرى. Sallitna uses the camera to photograph what to buy.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E7A42"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F6F4EF",
    "owner": "mostafag",
    "extra": {
      "eas": {
        "projectId": "69018711-8bf2-490f-99de-0afb1ba6ef9b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/69018711-8bf2-490f-99de-0afb1ba6ef9b"
    }
  }
}
